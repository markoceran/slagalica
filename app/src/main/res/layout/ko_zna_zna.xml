<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bgc"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp">

            <Button
                android:id="@+id/blue_player"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="30dp"
                android:layout_weight="1"
                android:background="@drawable/btn_2"
                android:text="10"
                android:textColor="@android:color/white"
                android:textSize="24sp" />


            <Button
                android:id="@+id/stopwatch"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_marginRight="30dp"
                android:layout_weight="1"
                android:background="@drawable/btn_round_yellow"
                android:text="60"
                android:textColor="@android:color/black"
                android:textSize="30sp" />

            <Button
                android:id="@+id/red_player"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/btn_red"
                android:text="15"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:background="@drawable/input_bg"
                android:text="KO ZNA ZNA"
                android:textAlignment="center"
                android:textColor="@color/colorWhite"
                android:textSize="24sp" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/neZnamButton"
                android:layout_width="107dp"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="@string/ne_znam" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="285dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/redniBrojPitanja"
                android:layout_width="83dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="redni broj" />

            <TextView
                android:id="@+id/pitanje"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="pitanje" />

        </LinearLayout>

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TableRow>

                <Button
                    android:id="@+id/odgovor1Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="odgovor 1" />

                <Button
                    android:id="@+id/odgovor2Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="odgovor 2" />
            </TableRow>

            <TableRow>

                <Button
                    android:id="@+id/odgovor3Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:text="odgovor 3" />

                <Button
                    android:id="@+id/odgovor4Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_weight="1"
                    android:text="odgovor 4" />


            </TableRow>




        </TableLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>