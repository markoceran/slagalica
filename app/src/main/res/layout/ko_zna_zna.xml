<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bgc"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/naslov"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/colorWhite"
            android:textSize="20dp"
            android:text="Ko zna zna" />
    </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/neZnamButton"
                android:layout_width="107dp"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:text="@string/ne_znam" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="285dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/redniBrojPitanja"
                android:layout_width="83dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="redni broj" />

            <TextView
                android:id="@+id/pitanje"
                android:layout_width="fill_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="pitanje" />

        </LinearLayout>

        <TableLayout
            android:layout_width = "match_parent"
            android:layout_height= "match_parent">

            <TableRow>
                <Button
                    android:id="@+id/odgovor1Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="odgovor 1" />

                <Button
                    android:id="@+id/odgovor2Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="odgovor 2" />
            </TableRow>

            <TableRow>
                <Button
                    android:id="@+id/odgovor3Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="odgovor 3"
                    android:layout_marginTop="20dp"/>

                <Button
                    android:id="@+id/odgovor4Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="odgovor 4"
                    android:layout_marginTop="20dp"/>


            </TableRow>


        </TableLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>