<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgc">

<LinearLayout
    android:id="@+id/mojBrojPage"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bgc"
    android:orientation="vertical"
    android:theme="@style/Theme.Slagalica"
    tools:context=".fragments.MojBrojFragment">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/blue_player"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="30dp"
            android:layout_weight="1"
            android:background="@drawable/btn_2"
            android:text="10"
            android:textColor="@android:color/white"
            android:textSize="24sp" />


        <Button
            android:id="@+id/stopwatch"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_marginRight="30dp"
            android:layout_weight="1"
            android:background="@drawable/btn_round_yellow"
            android:text="60"
            android:textColor="@android:color/black"
            android:textSize="30sp" />

        <Button
            android:id="@+id/red_player"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_red"
            android:text="15"
            android:textColor="@android:color/white"
            android:textSize="24sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="50dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_bg"
            android:text="PRONAĐI NAJBLIŽE REŠENJE"
            android:textAlignment="center"
            android:textColor="@color/colorWhite"
            android:textSize="24sp" />

    </LinearLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TableRow>

            <Button
                android:id="@+id/button_wanted_number"
                android:layout_width="131dp"
                android:layout_height="50dp"
                android:background="@drawable/btn_bg"
                android:text="233"
                android:textAlignment="center"
                android:textSize="24sp"
                android:layout_column="1" />


        </TableRow>
        <TableRow>

            <Button
                android:id="@+id/button_blue_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_2"
                android:text="@string/question_mark"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="24sp" />
            <Button
                android:id="@+id/button_red_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_red"
                android:text="@string/question_mark"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:layout_column="2"/>

        </TableRow>


        <EditText
            android:id="@+id/textInputResult"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/btn_bg"
            android:drawableRight="@drawable/backspace"
            android:text="  0"
            android:textSize="50dp"
            android:textColor="@color/colorWhite"
            android:textColorHint="@color/colorBlack"
            android:layout_marginTop="40dp"/>

        <TableRow>

            <Button
                android:id="@+id/button_potvrdi"
                android:layout_width="131dp"
                android:layout_height="48dp"
                android:background="@drawable/btn_yellow"
                android:text="POTVRDI"
                android:textAlignment="center"
                android:textSize="20sp"
                android:layout_column="1"
                android:layout_marginTop="20dp"/>
        </TableRow>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/button_number1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:background="@drawable/btn_bg2"
                android:text="4"
                android:textAlignment="center"
                android:textSize="24sp"
                android:layout_marginRight="10dp"/>


            <Button
                android:id="@+id/button_number2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_bg2"
                android:text="1"
                android:textAlignment="center"
                android:textSize="24sp"
                android:layout_marginRight="10dp"/>

            <Button
                android:id="@+id/button_number3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_bg2"
                android:text="9"
                android:textAlignment="center"
                android:textSize="24sp"
                android:layout_marginRight="10dp"/>

            <Button
                android:id="@+id/button_number4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_bg2"
                android:text="1"
                android:textAlignment="center"
                android:textSize="24sp" />

        </LinearLayout>


        <TableRow>

            <Button
                android:id="@+id/button_number5"
                android:layout_width="131dp"
                android:layout_height="50dp"
                android:background="@drawable/btn_bg2"
                android:text="20"
                android:textAlignment="center"
                android:textSize="24sp" />



            <Button
                android:id="@+id/button_number6"
                android:layout_width="131dp"
                android:layout_height="50dp"
                android:background="@drawable/btn_bg2"
                android:text="50"
                android:textAlignment="center"
                android:textSize="24sp"
                android:layout_column="2"/>

        </TableRow>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="70dp"
            android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/symbol1"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_blue3"
            android:text="+"
            android:textAlignment="center"
            android:textSize="28sp" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/symbol2"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_blue3"
            android:text="-"
            android:textAlignment="center"
            android:textSize="28sp" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/symbol3"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_blue3"
            android:text="x"
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/symbol4"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_blue3"
            android:text="/"
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/symbol5"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_blue3"
            android:text="("
            android:textAlignment="center"
            android:textSize="24sp" />

        <TextView
            android:layout_width="12dp"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/symbol6"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="@drawable/btn_blue3"
            android:text=")"
            android:textAlignment="center"
            android:textSize="24sp" />

        </LinearLayout>

    </TableLayout>


</LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>